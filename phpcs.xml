<?xml version="1.0"?>
<ruleset name="InkSync">
    <description>PSR-12 coding standard for InkSync</description>

    <arg name="colors"/>
    <arg value="p"/>

    <file>backend</file>
    <file>pages</file>
    <file>templates</file>
    <file>index.php</file>
    <file>router.php</file>
    <file>warmup.php</file>

    <exclude-pattern>backend/security/*</exclude-pattern>
    <exclude-pattern>scripts/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>storage/*</exclude-pattern>
    <!-- Pure-HTML partial, no PHP to lint -->
    <exclude-pattern>pages/panel_partial.php</exclude-pattern>

    <rule ref="PSR12"/>

    <!-- First PHPCS pass on a pre-existing codebase: 0 errors, ~85 warnings
         remain (mostly long legal-text lines in privacy.php/consent.php,
         and 4 entry-point files that mix declarations with side effects,
         which is a real architectural fix, not a lint fix). Fail the
         build on errors only, so CI doesn't block on those until
         addressed deliberately. -->
    <config name="ignore_warnings_on_exit" value="1"/>
</ruleset>
