# ======================
# CUSTOM
# ======================
# NOTE (2026-08-03): 10k_common_passwords.txt was gitignored here, but
# validate_password() (backend/check_login.php) reads it at runtime with no
# fallback -- a fresh clone/CI checkout would 500 on first login attempt.
# It's a public wordlist, not a secret, and only 72KB -- committing it.
.DS_Store
Thumbs.db
doc/

# ======================
# SECRETS & CONFIG
# ======================
config.php
.env
.env.*
*.env
config.local.php
secrets.php

# ======================
# PHP
# ======================
# NOTE (2026-08-04): composer.lock was gitignored here, but this is an
# application (not a published library) -- standard practice is to commit
# the lock file so every environment (dev, CI, prod) installs the exact
# same dependency versions instead of silently drifting. Committing it.
/vendor/
*.log
*.cache

# ======================
# NODE / JS
# ======================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.npm

# ======================
# PYTHON (if used)
# ======================
__pycache__/
*.py[cod]
.venv/
venv/

